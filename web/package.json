{
  "name": "elc-web",
  "version": "1.0.0",
  "private": true,
  "description": "A powerful application for English Learning Classes. Date: 19 Oct 2026.",
  "author": "Shuohui Liu",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "test:e2e": "node --test --test-concurrency=1 tests/us001.test.mjs",
    "test:staff-ui": "node tests/run-staff-ui.mjs",
    "test:lessons-unit": "node --test tests/lessons-api.test.mjs tests/lesson-search-copy-api.test.mjs",
    "test:lessons-ui": "node tests/run-lessons-ui.mjs",
    "test:sessions-unit": "node --test tests/class-sessions-api.test.mjs",
    "test:sessions-ui": "node tests/run-sessions-ui.mjs",
    "test:materials-unit": "node --test tests/materials-api.test.mjs",
    "test:materials-ui": "node tests/run-materials-ui.mjs",
    "test:reports-unit": "node --test tests/attendance-reports-api.test.mjs",
    "test:reports-ui": "node tests/run-reports-ui.mjs",
    "test:checkin-unit": "node --test tests/checkin-management-api.test.mjs",
    "test:checkin-ui": "node tests/run-checkin-ui.mjs",
    "test:public-unit": "node --test tests/club-information.test.mjs",
    "test:public-ui": "node tests/run-public-ui.mjs",
    "test:public-a11y": "node tests/run-public-ui.mjs --a11y",
    "test:history-unit": "node --test tests/attendance-history-api.test.mjs",
    "test:history-ui": "node tests/run-history-ui.mjs",
    "test:history-session": "node --test tests/history-session.test.mjs"
  },
  "dependencies": {
    "@lit/react": "1.0.8",
    "@material/web": "2.5.0",
    "next": "15.5.28",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "axe-core": "4.14.0",
    "lighthouse": "13.5.0",
    "playwright": "1.62.1",
    "typescript": "^5.0.0"
  }
}
