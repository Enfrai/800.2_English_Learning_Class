# Example environment variables for local microservice deployment.
#
# Author: Shuohui Liu
# Date: 19 Oct 2026

# Development-only values; change before use on any shared network.
USER_DB_PASSWORD=local_user_password
ACCESS_DB_PASSWORD=local_access_password
LESSON_DB_PASSWORD=local_lesson_password
DEMO_USERNAME=demo
DEMO_PASSWORD=DemoPass123!


# Set true when the public gateway uses HTTPS.
COOKIE_SECURE=false
LESSON_SERVICE_URL=http://lesson-service:8000

# For phone scanning, set the computer LAN address and bind the gateway to LAN.
CHECKIN_PUBLIC_ORIGIN=http://localhost:8080
AKO_BIND_ADDRESS=127.0.0.1
# Both Accessment replicas must share this value; changing it requires new codes.
CHECKIN_TOKEN_SECRET=local_checkin_token_secret
